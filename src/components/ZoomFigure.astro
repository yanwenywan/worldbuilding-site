---
// import map from "./images/map.png" then <ZoomFigure src={map} alt="..." caption="..." />
import "../styles/components/zoomfigure.scss";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    caption?: string;
}

const INLINE_MAX_WIDTH = 1600;

const { src, alt, caption } = Astro.props;
const inlineWidth = Math.min(src.width, INLINE_MAX_WIDTH);
const fullImage = await getImage({ src: src, width: src.width, format: "webp" });
---
<figure class="zoom-figure">
    <button type="button" class="zoom-figure-open" aria-label={`Open ${alt} full size`}>
        <Image src={src} alt={alt} width={inlineWidth} />
        <span class="zoom-figure-hint" aria-hidden="true">⤢</span>
    </button>
    {caption && <figcaption>{caption}</figcaption>}

    <dialog class="zoom-dialog" aria-label={alt} data-pagefind-ignore>
        <div class="zoom-dialog-bar">
            <span class="zoom-dialog-caption">{caption}</span>
            <button type="button" class="zoom-dialog-button" data-zoom="out" aria-label="Zoom out">−</button>
            <button type="button" class="zoom-dialog-button" data-zoom="in" aria-label="Zoom in">+</button>
            <button type="button" class="zoom-dialog-button" data-zoom="fit" aria-label="Fit to screen" title="Fit to screen">⛶</button>
            <button type="button" class="zoom-dialog-button" data-zoom="close" aria-label="Close">×</button>
        </div>
        <div class="zoom-dialog-viewport">
            <img
                class="zoom-dialog-image"
                data-src={fullImage.src}
                alt={alt}
                width={src.width}
                height={src.height}
                draggable="false"
            />
        </div>
    </dialog>
</figure>

<script>
    import "../scripts/zoom-figure.ts";
</script>
