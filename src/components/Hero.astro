---
// <Hero title subtitle tagline image imageFocus /> is the landing page header. Tagline is in draconic.
import "../styles/components/hero.scss";
import type { ImageMetadata } from "astro";
import type { ImageFocus } from "../utils/nav";
import BackdropImage from "./BackdropImage.astro";

interface Props {
    title: string;
    subtitle?: string;
    tagline?: string;
    image?: ImageMetadata;
    imageFocus?: ImageFocus;
}

const { title, subtitle, tagline, image, imageFocus } = Astro.props;
---
<section class:list={["hero", { "has-image": image }]}>
    {image && <BackdropImage image={image} focus={imageFocus} />}
    <div class="hero-inner">
        {subtitle && <p class="hero-subtitle" lang="zh">{subtitle}</p>}
        <h1 class="hero-title" data-pagefind-meta="title">{title}</h1>
        {tagline && <p class="hero-tagline draconic">{tagline}</p>}
        <div class="hero-rule" aria-hidden="true"><span class="hero-seal"></span></div>
    </div>
</section>
