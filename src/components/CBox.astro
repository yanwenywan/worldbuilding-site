---
// <CBox> centres content on full-width pages such as the landing page; <CBox wide> for grids.
import "../styles/components/cbox.scss";

interface Props {
    wide?: boolean;
    class?: string;
}

const { wide = false, class: className } = Astro.props;
---
<div class:list={["cbox", { wide }, className]}>
    <slot />
</div>
