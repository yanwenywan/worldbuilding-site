---
// pill shape tag for display 
// Default green with white text
import "../styles/components/pill.scss";

interface Props {
	zhong?: boolean  // chinese tag, red with 中 
	rekh?: boolean  // draconic tag, gold with REKH
	red?: boolean  // generic red tag
	gold?: boolean  // generic gold tag
}

const {
  zhong = false,
  rekh = false,
  red = false,
  gold = false
} = Astro.props
---
<span class={"pill" + (zhong || red ? " pillred" : "") + (rekh || gold ? " pillgold" : "")}>
    {
      zhong ? (<span>中</span>) 
      : rekh ? (<span class="draconic">REKH</span>)
      : (<slot/>)
    }
</span>